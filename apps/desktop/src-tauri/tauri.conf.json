{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LIVEPLAYER",
  "version": "1.0.0",
  "identifier": "com.liveplayer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LIVEPLAYER",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "backgroundColor": "#0a0b0d",
        "theme": "Dark",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "LIVEPLAYER",
    "copyright": "LIVEPLAYER · GNU AGPL-3.0-or-later",
    "category": "Music",
    "shortDescription": "Reproductor multitrack para tocar en vivo",
    "longDescription": "LIVEPLAYER reproduce secuencias multitrack para tocar en vivo: click, cues, mezcla por canción, setlists y Live Mode.",
    "homepage": "https://github.com/JJMELGAR04/Multittack-Player",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "LIVEPLAYER"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
